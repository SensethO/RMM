# RMM Platform - Environment Variables

# === Backend API ===
PORT=3000
NODE_ENV=development

# === Supabase Configuration ===
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# === Legacy: Local Database (optional for local dev) ===
# DATABASE_URL=postgresql://rmm_user:rmm_password@localhost:5432/rmm_db
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# === Redis (Cache & Pub/Sub) ===
REDIS_URL=redis://localhost:6379

# === Azure AD Configuration ===
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-app-id
AZURE_CLIENT_SECRET=your-azure-secret
JWT_SECRET=your-secret-key-change-in-production

# === Frontend URL (for CORS) ===
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# === Logging ===
LOG_LEVEL=info

# === Agent Configuration ===
AGENT_API_KEY=default-agent-key-change-per-agent
AGENT_REGISTRATION_ENABLED=true

# === Features ===
ENABLE_DEVICE_REAL_TIME_ALERTS=true
COMMAND_EXECUTION_TIMEOUT_MS=300000
