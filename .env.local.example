# Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# === Supabase ===
# Get these from: https://app.supabase.com/projects/[project-id]/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === Azure AD ===
# Get these from: https://portal.azure.com/
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret

# === JWT Secret ===
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here

# === Frontend URLs ===
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# === Azure AD Frontend ===
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
