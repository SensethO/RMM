# RMM Platform - Production Environment Variables
# Fill in your actual credentials from:
# - Supabase: https://console.supabase.com/projects
# - Azure AD: https://portal.azure.com

# ===== SUPABASE =====
# Get from: Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_KEY=YOUR_SERVICE_KEY_HERE

# ===== AZURE AD =====
# Get from: Azure AD → App Registrations → Your App
AZURE_TENANT_ID=YOUR_TENANT_ID_HERE
AZURE_CLIENT_ID=YOUR_CLIENT_ID_HERE
AZURE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# ===== JWT SECRET =====
# Generate random string (e.g., openssl rand -base64 32)
JWT_SECRET=YOUR_RANDOM_SECRET_HERE

# ===== DEPLOYMENT URLS =====
# Update after Vercel deployment
VITE_API_URL=https://rmm-api.vercel.app
FRONTEND_URL=https://rmm-frontend.vercel.app

# ===== NODE ENV =====
NODE_ENV=production
