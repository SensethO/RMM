<?xml version="1.0" encoding="UTF-8"?>
<!--
  RMM Agent - WiX v5 Installer
  Build: wix build installer.wxs -ext WixToolset.Util.wixext -out rmm-agent-setup.msi -arch x64
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="RMM Agent"
    Manufacturer="SensethO"
    Version="1.1.1"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Language="1036"
    Codepage="1252"
    Scope="perMachine">

    <MajorUpgrade
      DowngradeErrorMessage="Une version plus récente de RMM Agent est déjà installée."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ─── Propriétés ──────────────────────────────────────────────── -->
    <!-- cmd.exe est toujours dans System32 sur Windows -->
    <Property Id="CMDEXE" Value="C:\Windows\System32\cmd.exe" />

    <!-- ─── Custom Actions ─────────────────────────────────────────── -->

    <!-- Créer + démarrer la tâche planifiée (install) -->
    <CustomAction Id="CA_CreateTask"
      Property="CMDEXE"
      ExeCommand='/c schtasks /create /tn "RMM-Agent" /tr "\"[INSTALLFOLDER]rmm-agent.exe\"" /sc onstart /delay 0000:30 /ru SYSTEM /rl HIGHEST /f &amp;&amp; schtasks /run /tn "RMM-Agent"'
      Return="ignore"
      Impersonate="no" />

    <!-- Arrêter + supprimer la tâche (désinstall) -->
    <CustomAction Id="CA_RemoveTask"
      Property="CMDEXE"
      ExeCommand='/c schtasks /end /tn "RMM-Agent" &amp; schtasks /delete /tn "RMM-Agent" /f'
      Return="ignore"
      Impersonate="no" />

    <!-- ─── Séquences ───────────────────────────────────────────────── -->
    <InstallExecuteSequence>
      <Custom Action="CA_CreateTask" After="InstallFiles"
              Condition="NOT Installed OR UPGRADINGPRODUCTCODE" />
      <Custom Action="CA_RemoveTask" Before="RemoveFiles"
              Condition="Installed AND REMOVE AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- ─── Features ───────────────────────────────────────────────── -->
    <Feature Id="ProductFeature" Title="RMM Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
    </Feature>

  </Package>

  <!-- ─── Arborescence d'installation ─────────────────────────────── -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerDir" Name="SensethO">
        <Directory Id="INSTALLFOLDER" Name="RMM Agent" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <!-- ─── Composants ───────────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">

      <!-- Exécutable principal -->
      <Component Id="AgentExe" Guid="11111111-1111-1111-1111-111111111111">
        <File Id="RMMAgentExe"
              Source="dist\rmm-agent.exe"
              Name="rmm-agent.exe"
              KeyPath="yes"
              Checksum="yes" />
      </Component>

      <!-- Clés de registre (version + chemin d'installation) -->
      <Component Id="RegistryEntries" Guid="33333333-3333-3333-3333-333333333333">
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\SensethO\RMMAgent"
          Name="InstallPath"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes" />
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\SensethO\RMMAgent"
          Name="Version"
          Type="string"
          Value="1.1.1" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
