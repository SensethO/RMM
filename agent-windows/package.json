{
  "name": "rmm-agent",
  "version": "1.1.1",
  "description": "RMM Windows Agent",
  "main": "agent.js",
  "scripts": {
    "build": "pkg agent.js --target node18-win-x64 --output build/dist/rmm-agent.exe --compress GZip",
    "build:all": "pkg agent.js --targets node18-win-x64,node18-win-ia32 --output build/dist/rmm-agent --compress GZip"
  },
  "pkg": {
    "targets": ["node18-win-x64"],
    "outputPath": "build/dist",
    "assets": [],
    "compress": "GZip"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
